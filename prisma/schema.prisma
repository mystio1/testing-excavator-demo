// Excavator Owner Management Software — data model
// SQLite has no native enum support, so status/type fields are documented
// strings (validated at the zod layer in src/lib/validation) rather than
// Prisma enums.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Business {
  id                           String                @id @default(cuid())
  operatorJoinRequests         OperatorJoinRequest[]
  name                         String
  ownerName                    String
  phone                        String
  address                      String?
  gstNumber                    String?
  // Short, human-shareable code an operator enters at /operator-signup to
  // scope their activation to this business — see registerBusiness /
  // regenerateBusinessCode. Never editable directly, only regenerated.
  code                         String                @unique
  defaultServiceIntervalHrs    Float                 @default(350)
  maintenanceAlertThresholdHrs Float                 @default(50)
  // "en" | "hi" | "mr" — controls the display language of the whole
  // operator portal (login/signup through every dialog), set here by the
  // Admin. The pre-login screens can't know which business a visitor
  // belongs to yet, so they stay in English; this takes effect from the
  // operator's own home page onward.
  operatorLanguage             String                @default("en")

  // Support-console-managed (see /support and src/lib/services/support.ts) —
  // not editable from anywhere in the normal owner-facing UI. frozen blocks
  // every API route except the ones that need to keep working to show the
  // frozen notice itself (see requireBusinessApi). maxOperators/
  // maxBillsPerDay are null (unlimited) for every business until support
  // deliberately sets a cap; enforced at operator creation and bill
  // creation respectively.
  frozen         Boolean @default(false)
  // Per-business switch for the assistant. On by default; support turns it off
  // for one business without a deploy when it misbehaves for them, and the
  // owner keeps the whole app. Checked on the server, so turning it off is not
  // merely a hidden button — the routes refuse.
  assistantEnabled Boolean @default(true)
  // Diagnostics for the assistant, ON only until this moment passes.
  //
  // A deliberate timestamp rather than a boolean: what is recorded while it is
  // on is what the owner actually SAID, which can carry their customers'
  // names and numbers. A flag can be left on by accident forever; a window
  // closes itself. Null or past means nothing is recorded, which is the
  // default for every business.
  diagnosticsUntil DateTime?
  // Per-business model override for the assistant. Null means the deployment's
  // own choice (GROQ_MODEL). It exists so one business can be moved to a
  // different model without moving everyone — to try a better one on a willing
  // customer, or to move one off a model that is answering them badly, neither
  // of which should require a deploy. Validated against an allowlist, not
  // taken as free text: an arbitrary string here would be a way to point this
  // business's spending at an unknown model.
  assistantModel   String?
  maxOperators   Int?
  maxBillsPerDay Int?

  // Bill letterhead — configured once in Settings, snapshotted onto each
  // Bill at generation time so historical bills never change retroactively.
  logoLeftUrl     String? // data: URI, small enough to keep inline
  logoRightUrl    String?
  signatureUrl    String?
  billTagline     String? // e.g. "Excavation & Earthwork Services"
  billAccentColor String  @default("#0B2B5E")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  excavators            Excavator[]
  sites                 Site[]
  customers             Customer[]
  operators             Operator[]
  serviceItems          ServiceItem[]
  excavatorExpenses     ExcavatorExpense[]
  bankAccounts          BankAccount[]
  bills                 Bill[]
  billNumberSequences   BillNumberSequence[]
  payments              Payment[]
  transactionCategories TransactionCategory[]
  operatorWorkRequests  OperatorWorkRequest[]
  auditLogs             AuditLog[]
  agentTasks            AgentTask[]
  agentUsage            AgentUsage[]
  agentTurnLogs         AgentTurnLog[]
  agentNameAliases      AgentNameAlias[]
}

// Written by support-console actions (see src/lib/services/support.ts) —
// impersonate/freeze/unfreeze/setLimits — attributed to the target
// business's own owner user where one exists, so there's always a durable
// trace of when and what support did on a business's behalf. Not currently
// surfaced in the owner-facing UI (support-only, for now).
model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  userName   String
  action     String
  entityId   String
  details    Json     @default("{}")
  // Financial audit trail (append-only — enforced by a DB trigger, see the
  // audit_log_append_only migration).
  actorType  String   @default("OWNER") // OWNER | OPERATOR | SUPPORT | SYSTEM
  actorId    String?
  entityType String   @default("")
  before     Json?
  after      Json?
  reason     String?
  requestId  String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([entityId])
  @@index([businessId, entityType, entityId])
}

// Multiple bank accounts a business may bill against — the owner picks one
// per bill (e.g. a different account for GST vs Non-GST invoicing).
model BankAccount {
  id                 String   @id @default(cuid())
  businessId         String
  label              String
  accountHolderName  String
  accountNumber      String
  ifsc               String
  bankName           String
  branch             String?
  isDefaultForGst    Boolean  @default(false)
  isDefaultForNonGst Boolean  @default(false)
  isArchived         Boolean  @default(false)
  createdAt          DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bills    Bill[]

  @@index([businessId])
}

// role is a plain string ("OWNER" for now); kept as a field rather than an
// enum so more roles (staff/accountant) can be added later without a migration.
model User {
  id               String    @id @default(cuid())
  tokenVersion     Int       @default(0) // bump to invalidate every issued session JWT
  businessId       String
  name             String
  email            String    @unique
  // Nullable for legacy rows only — registerBusiness always collects one.
  // Unique so login-by-phone can findUnique() the same way login-by-email
  // does; null values are exempt from the constraint (multiple users can
  // still have no phone on file).
  phone            String?   @unique
  passwordHash     String
  role             String    @default("OWNER")
  // Forgot-password flow: a hash of the single-use reset token (never the
  // raw token itself — same principle as passwordHash) plus its expiry.
  // Both null once unused/consumed/expired.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  // Optional app-lock PIN (4 or 6 digits) — a lightweight re-unlock gate on
  // top of an already-valid session, not a replacement for passwordHash.
  // Null means the owner hasn't turned this on; set from Settings.
  appPinHash       String?
  // Voice consent for the assistant. Speaking to it sends a few seconds of
  // audio — which carries customer names and phone numbers — to a speech
  // service outside India, so the owner is told that plainly and asked once
  // before the microphone is ever used. Null means never asked or declined;
  // the assistant still works by typing either way. Stored rather than kept in
  // the browser because consent has to be demonstrable, and a localStorage
  // flag proves nothing and is lost with the device.
  voiceConsentAt   DateTime?
  // Which wording they agreed to, so a later change to the notice does not
  // silently inherit an older consent.
  voiceConsentText String?
  createdAt        DateTime  @default(now())

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([businessId])
  @@index([resetTokenHash])
}

// ---------------------------------------------------------------------------
// Core fleet / people
// ---------------------------------------------------------------------------

// status: "WORKING" | "IDLE" | "SERVICE" — live pointer for fast dashboard
// reads; WorkSession/ServiceRecord rows remain the source of truth for history.
//
// currentOperatorId is the stable, weeks-long operator<->machine pairing —
// set once from the Machine page, unaffected by daily WorkSession
// start/stop cycles. WorkSession.operatorId is snapshotted from this value
// each time a job starts, so job history stays accurate even after the
// pairing later changes; OperatorAssignment is the append-only history of
// every pairing this machine has had.
model Excavator {
  id                 String    @id @default(cuid())
  version            Int       @default(0) // optimistic concurrency: bumped on every update
  businessId         String
  name               String
  machineNumber      String?
  brand              String?
  model              String?
  purchaseDate       DateTime?
  startingHourMeter  Float     @default(0)
  currentHourMeter   Float     @default(0)
  serviceIntervalHrs Float?
  status             String    @default("IDLE")
  currentOperatorId  String?
  // Stable, admin-set default site for this machine — set directly by the
  // Admin (instant, no approval) or proposed by an Operator starting/editing
  // a job (only takes effect once that job is approved). Never touched by
  // daily job start/stop on its own; stays as-is until someone changes it.
  currentSiteId      String?
  isArchived         Boolean   @default(false)
  // Admin-chosen display order on the Machines page and in machine pickers
  // (lower first). New machines go to the end.
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currentOperator Operator? @relation(fields: [currentOperatorId], references: [id], onDelete: SetNull)
  currentSite     Site?     @relation("ExcavatorCurrentSite", fields: [currentSiteId], references: [id], onDelete: SetNull)

  workSessions         WorkSession[]
  serviceRecords       ServiceRecord[]
  expenses             ExcavatorExpense[]
  billItems            BillItem[]
  directBills          Bill[]
  operatorAssignments  OperatorAssignment[]
  operatorWorkRequests OperatorWorkRequest[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([currentOperatorId])
}

// Append-only history of every operator<->machine pairing, independent of
// WorkSession (a job) — one machine has exactly one OPEN (endDate: null) row
// at a time, mirrored by Excavator.currentOperatorId for fast reads.
// status: "ACTIVE" | "ENDED"
model OperatorAssignment {
  id          String    @id @default(cuid())
  businessId  String
  excavatorId String
  operatorId  String
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())

  excavator Excavator @relation(fields: [excavatorId], references: [id], onDelete: Cascade)
  operator  Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([excavatorId])
  @@index([operatorId])
}

model Site {
  id          String   @id @default(cuid())
  version     Int      @default(0) // optimistic concurrency: bumped on every update
  businessId  String
  name        String
  address     String? // shown as the site's "location"
  // "CUSTOMER_SITE" | "SELF_SITE". A self site (own work) needs no customer.
  type        String   @default("CUSTOMER_SITE")
  // "ACTIVE" | "COMPLETED" | "ON_HOLD"
  status      String   @default("ACTIVE")
  customerId  String?
  // CURRENT hourly rates for work at this site. Every change is also written to
  // SiteRateHistory (effective-dated) so earlier work is always valued at the rate
  // that applied then, and bills keep their own snapshot (BillItem.ratePerHour).
  bucketRate  Decimal? @db.Decimal(14, 2)
  breakerRate Decimal? @db.Decimal(14, 2)
  createdAt   DateTime @default(now())

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rateHistory  SiteRateHistory[]
  workSessions WorkSession[]
  // Machines currently parked/working at this site — Excavator.currentSiteId,
  // the stable admin-set default the operator sees (see that field's comment).
  excavators   Excavator[]       @relation("ExcavatorCurrentSite")

  @@index([businessId])
  @@index([customerId])
}

// Effective-dated rate history for a site: the rate in force on a day is the latest row whose
// effectiveFrom is on or before that day. Append-only in practice (a rate change adds a row).
model SiteRateHistory {
  id            String   @id @default(cuid())
  businessId    String
  siteId        String
  bucketRate    Decimal? @db.Decimal(14, 2)
  breakerRate   Decimal? @db.Decimal(14, 2)
  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([siteId, effectiveFrom])
}

model Customer {
  sites       Site[]
  id          String   @id @default(cuid())
  version     Int      @default(0) // optimistic concurrency: bumped on every update
  businessId  String
  name        String
  mobile      String
  companyName String?
  address     String?
  gstNumber   String?
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  workSessions WorkSession[]
  bills        Bill[]

  @@index([businessId])
}

model Operator {
  id                   String    @id @default(cuid())
  tokenVersion         Int       @default(0) // bump to invalidate every issued session JWT
  version              Int       @default(0) // optimistic concurrency: bumped on every update
  businessId           String
  name                 String
  mobile               String
  address              String?
  joiningDate          DateTime?
  defaultMonthlySalary Decimal   @default(0) @db.Decimal(14, 2)
  isArchived           Boolean   @default(false)
  // Operator self-login (portal): PIN-based, separate from the owner's
  // email/password login. canLogin stays false until the Admin explicitly
  // enables the portal for this operator and sets a PIN.
  pinHash              String?
  canLogin             Boolean   @default(false)
  // Operator's own language choice for the portal (post-login) — overrides
  // Business.operatorLanguage when set. Null means the operator hasn't
  // personally picked one yet, so the admin's business-wide default applies.
  language             String?
  createdAt            DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  workSessions         WorkSession[]
  transactions         OperatorTransaction[]
  assignedExcavators   Excavator[]
  assignments          OperatorAssignment[]
  operatorWorkRequests OperatorWorkRequest[]
  workingPeriods       OperatorWorkingPeriod[]
  leaves               OperatorLeave[]

  @@index([businessId])
  @@index([mobile])
}

// A continuous stretch during which an operator works and salary accrues. An operator who goes on
// leave and returns gets a NEW period; the joining date is never changed and closed periods are never
// rewritten. status: "ACTIVE" | "CLOSED". At most one ACTIVE period per operator (partial unique index).
// openingBalance + openingSourcePeriodId record a carry-forward from an earlier period (a transfer of
// what was owed, NOT new salary); openingSourcePeriodId is unique so a period can be carried only once.
model OperatorWorkingPeriod {
  id                    String    @id @default(cuid())
  version               Int       @default(0)
  businessId            String
  operatorId            String
  startDate             DateTime
  endDate               DateTime?
  status                String    @default("ACTIVE")
  monthlySalary         Decimal   @default(0) @db.Decimal(14, 2)
  salaryBasisDays       Int       @default(30)
  openingBalance        Decimal   @default(0) @db.Decimal(14, 2)
  openingSourcePeriodId String?   @unique
  notes                 String?
  createdAt             DateTime  @default(now())
  closedAt              DateTime?

  operator  Operator               @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  source    OperatorWorkingPeriod? @relation("PeriodCarry", fields: [openingSourcePeriodId], references: [id], onDelete: Restrict)
  carriedTo OperatorWorkingPeriod? @relation("PeriodCarry")

  @@index([businessId])
  @@index([operatorId, startDate])
}

// A non-working gap between two periods. Unpaid leave accrues nothing; paid leave is recorded for the
// timeline (the salary rules for paid leave are the business's, see docs/operations.md).
// type: "UNPAID" | "PAID"
model OperatorLeave {
  id         String   @id @default(cuid())
  businessId String
  operatorId String
  startDate  DateTime
  endDate    DateTime
  type       String   @default("UNPAID")
  reason     String?
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([operatorId, startDate])
}

// ---------------------------------------------------------------------------
// Work tracking
// ---------------------------------------------------------------------------

// One job for a customer/site, spanning a date range (spec's Work History
// rows) — status: "ACTIVE" | "COMPLETED". operatorId is snapshotted from
// Excavator.currentOperatorId at start time (see OperatorAssignment for the
// operator<->machine pairing itself, which outlives any single job).
// totalHours is the sum of its DailyWorkLog rows, recomputed on every log
// add/edit/delete — never hand-entered.
model WorkSession {
  id             String    @id @default(cuid())
  version        Int       @default(0) // optimistic concurrency: bumped on every update
  businessId     String
  excavatorId    String
  customerId     String
  siteId         String
  operatorId     String
  startDate      DateTime
  endDate        DateTime?
  startHourMeter Float
  endHourMeter   Float?
  totalHours     Float     @default(0)
  attachment     String? // bucket/breaker/etc. reported in use — carried over from an OperatorWorkRequest on approval
  dieselLiters          Float? // reported diesel refill, if any, during this job — see getSiteAnalysis
  remainingDieselLiters Float? // closing balance: litres still in the tank at the end of this job's work
  dieselDate            DateTime?
  status                String    @default("ACTIVE")
  notes                 String?
  // When the operator submitted this work (null for admin-entered work); the work dates are startDate/endDate.
  submittedAt           DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  excavator Excavator @relation(fields: [excavatorId], references: [id], onDelete: Restrict)
  customer  Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  operator  Operator  @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  dailyLogs           DailyWorkLog[]
  billItems           BillItem[]
  operatorWorkRequest OperatorWorkRequest?

  @@index([businessId])
  @@index([excavatorId])
  @@index([customerId])
  @@index([operatorId])
  @@index([businessId, status])
}

// An operator-initiated job, self-started and self-ended from the portal —
// kept entirely separate from WorkSession (which requires a Customer/Site
// for billing, neither of which the operator picks) so nothing here ever
// touches Excavator.currentHourMeter, billing, or maintenance math until an
// Admin approves it and it becomes a real WorkSession.
//
// status: "ACTIVE" (started, no end submitted — informational only, nothing
// to approve yet) -> "PENDING" (operator submitted an end reading, awaiting
// review) -> "APPROVED" (Admin picked a Customer/Site and it became
// workSession) | "REJECTED" (Admin sent it back; the operator can edit the
// end reading and resubmit, flipping it back to PENDING).
model OperatorWorkRequest {
  id             String    @id @default(cuid())
  businessId     String
  excavatorId    String
  operatorId     String
  startDate      DateTime
  startHourMeter Float
  endDate        DateTime?
  endHourMeter   Float?
  attachment     String? // bucket/breaker/etc. the operator reports using, free text
  // Proposed site for this job — defaults to Excavator.currentSiteName when
  // the operator starts (see startOperatorWork), editable by them. Only
  // updates the machine's actual currentSiteId once this request is
  // approved; left untouched, the machine's site simply carries on as-is.
  siteName       String?
  dieselLiters   Float?
  dieselDate     DateTime?
  notes          String?
  status         String    @default("ACTIVE")
  rejectionNote  String?
  workSessionId  String?   @unique
  createdAt      DateTime  @default(now())
  // When the operator actually submitted the work. startDate/endDate are the dates the work was DONE
  // (entered by the operator); this is the separate submission time.
  submittedAt    DateTime?
  reviewedAt     DateTime?

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  excavator   Excavator    @relation(fields: [excavatorId], references: [id], onDelete: Cascade)
  operator    Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  workSession WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([excavatorId])
  @@index([operatorId])
}

// hoursWorked is always server-computed (never accepted as raw input):
// either (endHourMeter - startHourMeter) or derived from start/stop time
// minus break minutes, whichever the owner filled in.
//
// source: "ADMIN" | "OPERATOR". status: "APPROVED" | "PENDING" | "REJECTED".
// Admin-entered logs are auto-approved (unchanged behavior). Operator-portal
// submissions land PENDING and do not move Excavator.currentHourMeter or
// WorkSession.totalHours until an Admin approves them — maintenance/billing
// must only ever see approved readings.
model DailyWorkLog {
  id             String    @id @default(cuid())
  version        Int       @default(0) // optimistic concurrency: bumped on every update
  workSessionId  String
  date           DateTime
  startTime      String?
  stopTime       String?
  breakMinutes   Int?
  startHourMeter Float?
  endHourMeter   Float?
  hoursWorked    Float
  // Free-text note of who actually operated that day — only ever set on the
  // ADMIN path (add-daily-log-dialog), always optional since the machine's
  // assigned operator already covers the common case. Operator-portal
  // submissions leave this null; the submitter's own identity is already known.
  operatorName   String?
  // Diesel reported alongside this specific day's reading — distinct from
  // OperatorWorkRequest's own dieselLiters/dieselDate (that's diesel
  // reported when starting/ending a whole job, this is diesel reported on
  // any day in between). Rolled into WorkSession.dieselLiters/dieselDate
  // (added, not overwritten — see stopWork/approveDailyLog) once this log
  // is APPROVED, same "unapproved data must never move anything real"
  // principle as startHourMeter/endHourMeter not touching
  // Excavator.currentHourMeter until then.
  dieselLiters          Float?
  // Closing balance: litres still in the tank at the end of this entry's work.
  // Carries into the next entry as its opening balance, so consumption is
  // consumed = (previous closing + dieselLiters) − this closing.
  // See dieselEntryAverage in services/siteAnalysis.ts.
  remainingDieselLiters Float?
  notes          String?
  // Tool reported in use that day ("Bucket" | "Breaker" | "Chaining", see
  // ATTACHMENT_VALUES) — set (not merged, unlike dieselLiters) onto
  // WorkSession.attachment once APPROVED, since it represents the current
  // tool rather than a quantity to sum.
  attachment     String?
  // "WORK" | "DIESEL_ONLY" (litres + date only: start = end = the previous ending reading, 0 hours)
  kind           String    @default("WORK")
  source         String    @default("ADMIN")
  status         String    @default("APPROVED")
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())

  workSession WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  @@index([workSessionId])
  @@index([date])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Operator money transactions & salary
// ---------------------------------------------------------------------------

// Reusable, per-business category catalog (mirrors ServiceItem) so a custom
// category typed once ("Mobile Repair") is available in the dropdown after.
model TransactionCategory {
  id         String  @id @default(cuid())
  businessId String
  name       String
  isDefault  Boolean @default(false)

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions OperatorTransaction[]

  @@index([businessId])
}

// Every owner<->operator money movement. Salary is never stored/duplicated —
// it's computed live per calendar month as:
//   defaultMonthlySalary + sum(BONUS_INCENTIVE) - sum(deductFromSalary=true) - sum(SALARY_PAYMENT)
// (see src/lib/services/salary.ts). This row *is* the business financial
// record (no separate expense row to keep in sync / accidentally double-count).
// businessEffect: "ADVANCE_RECOVERABLE" | "BUSINESS_EXPENSE" | "SALARY_PAYMENT" | "BONUS_INCENTIVE" | "OTHER"
model OperatorTransaction {
  id               String   @id @default(cuid())
  version          Int      @default(0) // optimistic concurrency: bumped on every update
  businessId       String
  operatorId       String
  categoryId       String?
  amount           Decimal  @db.Decimal(14, 2)
  date             DateTime
  notes            String?
  deductFromSalary Boolean  @default(true)
  businessEffect   String   @default("ADVANCE_RECOVERABLE")
  // Optional explicit link to a working period; when null the period is derived from `date`.
  workingPeriodId  String?
  createdAt        DateTime @default(now())

  operator Operator             @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  category TransactionCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([operatorId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Service & maintenance — component-level history
// ---------------------------------------------------------------------------

// Catalog of serviceable components (Engine Oil, Hydraulic Pump, Track
// Chain, ...), grouped by category. isDefault rows are seeded per business
// from the standard excavator component library; owners can add their own
// ("+ Add New Component"), which then stays in the dropdown for future
// services. defaultIntervalHours is left null unless the owner configures
// one — never a fabricated number — and only components with an interval
// set contribute to due/overdue status.
model ServiceItem {
  id                   String  @id @default(cuid())
  businessId           String
  name                 String
  category             String  @default("Other")
  defaultIntervalHours Float?
  isDefault            Boolean @default(false)

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordItems ServiceRecordItem[]

  @@index([businessId])
}

model ServiceRecord {
  id                 String   @id @default(cuid())
  businessId         String
  excavatorId        String
  serviceDate        DateTime
  hourMeterAtService Float
  serviceType        String?
  cost               Decimal  @default(0) @db.Decimal(14, 2)
  notes              String?
  nextServiceDueHour Float?
  createdAt          DateTime @default(now())

  excavator Excavator           @relation(fields: [excavatorId], references: [id], onDelete: Restrict)
  items     ServiceRecordItem[]

  @@index([businessId])
  @@index([excavatorId])
}

// Join table capturing what happened to each catalog component in a given
// service — this per-item history is what powers "what was skipped last
// time" / smart suggestions / component & replacement history.
// action: "Inspected" | "Serviced" | "Repaired" | "Replaced" | "Changed" |
//         "Cleaned" | "Greased" | "Not Done" | "Not Required" | "Other"
// done stays true unless action is "Not Done"/"Not Required", for quick filtering.
model ServiceRecordItem {
  id              String  @id @default(cuid())
  serviceRecordId String
  serviceItemId   String
  action          String  @default("Serviced")
  done            Boolean @default(true)
  cost            Decimal @default(0) @db.Decimal(14, 2)
  brand           String?
  notes           String?

  serviceRecord ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem   @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)

  @@index([serviceRecordId])
  @@index([serviceItemId])
}

// ---------------------------------------------------------------------------
// Expenses (schema only this session — no UI yet)
// ---------------------------------------------------------------------------

// type: "DIESEL" | "REPAIR" | "SERVICE" | "PARTS" | "TRANSPORT" | "TYRES" | "OTHER"
model ExcavatorExpense {
  id          String   @id @default(cuid())
  businessId  String
  excavatorId String
  date        DateTime
  type        String
  amount      Decimal  @db.Decimal(14, 2)
  notes       String?
  createdAt   DateTime @default(now())

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  excavator Excavator @relation(fields: [excavatorId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([excavatorId])
}

// ---------------------------------------------------------------------------
// Billing (schema only this session — no UI yet)
// ---------------------------------------------------------------------------

// type: "GST" | "NON_GST" — one counter per business+type so bill numbers
// (e.g. NG-0059) generate atomically without the owner tracking them.
model BillNumberSequence {
  id         String @id @default(cuid())
  businessId String
  type       String
  prefix     String
  lastNumber Int    @default(0)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type])
}

// billType: "GST" | "NON_GST"; status: "UNPAID" | "PARTIAL" | "PAID"
// paidAmount is a denormalized cache kept in sync by Payment writes so bill
// lists don't need to sum payments on every read; Payment rows remain the
// source of truth.
model Bill {
  id                  String    @id @default(cuid())
  version             Int       @default(0) // optimistic concurrency: bumped on every update
  businessId          String
  billNumber          String
  billType            String
  customerId          String
  bankAccountId       String?
  billDate            DateTime
  subtotal            Decimal   @db.Decimal(14, 2)
  transportCharges    Decimal   @default(0) @db.Decimal(14, 2)
  fuelCharges         Decimal   @default(0) @db.Decimal(14, 2)
  extraCharges        Decimal   @default(0) @db.Decimal(14, 2)
  bucketCharge        Decimal   @default(0) @db.Decimal(14, 2)
  breakerCharge       Decimal   @default(0) @db.Decimal(14, 2)
  discount            Decimal   @default(0) @db.Decimal(14, 2)
  gstPercentage       Decimal?  @db.Decimal(5, 2)
  cgst                Decimal?  @db.Decimal(14, 2)
  sgst                Decimal?  @db.Decimal(14, 2)
  igst                Decimal?  @db.Decimal(14, 2)
  buyerGstin          String?
  totalAmount         Decimal   @db.Decimal(14, 2)
  paidAmount          Decimal   @default(0) @db.Decimal(14, 2)
  status              String    @default("UNPAID")
  notes               String?
  // Owner's choice, made per-bill at generation time, of whether the
  // customer's phone number is printed on this bill — frozen like the rest
  // of the letterhead so toggling it later never rewrites past bills.
  showCustomerPhone   Boolean   @default(true)
  // Direct bill — a standalone invoice for bucket/breaker attachment hours
  // hired directly (no logged WorkSessions), entered by hand instead of
  // picked from work history. isDirect distinguishes it from the normal
  // WorkSession-based flow, which uses `items` (BillItem[]) instead of the
  // fields below. excavatorId is the single machine hired; bucket/breaker
  // hours+rate are billed as their own line items (unlike bucketCharge/
  // breakerCharge above, which are flat tool-usage surcharges on a normal
  // hourly bill). dieselAdvance (dieselLiters × dieselPricePerLiter) is
  // subtracted from the total — diesel the customer supplied counts as an
  // advance payment, not a charge.
  isDirect            Boolean   @default(false)
  excavatorId         String?
  fromDate            DateTime?
  toDate              DateTime?
  bucketHours         Decimal?  @db.Decimal(10, 2)
  bucketRate          Decimal?  @db.Decimal(14, 2)
  breakerHours        Decimal?  @db.Decimal(10, 2)
  breakerRate         Decimal?  @db.Decimal(14, 2)
  dieselLiters        Decimal?  @db.Decimal(10, 2)
  dieselPricePerLiter Decimal?  @db.Decimal(14, 2)
  dieselAdvance       Decimal?  @db.Decimal(14, 2)
  // Copy of business name/address/GST/logos/signature/bank details and the
  // template/accent used, taken when the bill is generated so a later Settings
  // change never rewrites bills on its own. Editing a bill deliberately
  // re-stamps this from current Settings (see updateBill).
  letterhead          Json
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  excavator   Excavator?   @relation(fields: [excavatorId], references: [id], onDelete: SetNull)

  items    BillItem[]
  payments Payment[]

  @@unique([businessId, billNumber])
  @@index([businessId])
  @@index([customerId])
}

// Links a bill line back to the underlying work so billed hours are never
// double-counted on a later bill.
model BillItem {
  id            String   @id @default(cuid())
  billId        String
  excavatorId   String
  workSessionId String?
  siteName      String // snapshotted at creation — a later site rename must not alter old bills
  attachment    String? // optional "Bucket" / "Breaker" tag for this line
  fromDate      DateTime
  toDate        DateTime
  hours         Decimal  @db.Decimal(10, 2)
  ratePerHour   Decimal  @db.Decimal(14, 2)
  amount        Decimal  @db.Decimal(14, 2)

  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  excavator   Excavator    @relation(fields: [excavatorId], references: [id], onDelete: Restrict)
  workSession WorkSession? @relation(fields: [workSessionId], references: [id], onDelete: SetNull)

  // One work session can be billed at most once — enforced by the database so
  // two concurrent bill requests cannot both succeed (NULLs are exempt, so
  // hand-typed Summary Bill lines are unaffected).
  @@unique([workSessionId])
  @@index([billId])
  @@index([excavatorId])
  @@index([workSessionId])
}

model Payment {
  id         String   @id @default(cuid())
  version    Int      @default(0) // optimistic concurrency: bumped on every update
  businessId String
  billId     String
  amount     Decimal  @db.Decimal(14, 2)
  date       DateTime
  method     String?
  notes      String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bill     Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([billId])
}

// ---------------------------------------------------------------------------
// Security / reliability infrastructure
// ---------------------------------------------------------------------------

// Idempotency for financial creates (bill, summary bill, payment). The row is
// inserted in the SAME transaction as the resource it protects, guarded by the
// unique index — so "the request succeeded but the client timed out, then
// retried" replays the stored response instead of creating a second record.
// Scoped per business (never global across tenants).
model IdempotencyKey {
  id             String   @id @default(cuid())
  businessId     String
  key            String
  operation      String // e.g. "bill.create", "payment.create"
  actorId        String?
  requestHash    String // sha256 of the canonical request payload
  resourceType   String?
  resourceId     String?
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([businessId, key])
  @@index([expiresAt])
}

// Sliding-window-counter rate limiting shared by every app instance and
// surviving restarts (see src/lib/rateLimit.ts). One row per (key, window).
// A half-finished assistant turn, waiting on the owner.
//
// These lived in a Map in one process, which was fine until it wasn't: Render
// restarts on every deploy and spins down on the free tier, and more than one
// instance can serve the same owner. The owner would tap "Yes, save it" and be
// told "That request has expired" — on the one action in the whole product
// that needs their explicit approval to happen at all.
//
// Short-lived by design (swept after TASK_TTL_MS). It holds what was said and
// what was gathered, which is the owner's own words about their own business —
// never anything from another tenant, and never a credential.
model AgentTask {
  id         String   @id
  businessId String
  // The task belongs to this user, not merely to this business: holding a task
  // id must be useless without being the person it was opened for.
  userId     String
  lang       String   @default("en")
  state      String
  workflowId String?
  // Values gathered so far, already resolved where they name a record.
  fields     Json     @default("{}")
  // What was actually asked, so a read-only task can answer THAT from the
  // screen rather than merely reporting that it got there.
  question   String?
  // Fingerprint of exactly what was approved — a later change cannot ride in
  // on an older yes.
  confirmedFingerprint String?
  operationId          String?
  // "Start all the machines" — the same instruction applied to several records,
  // one at a time. Holds which record is being done now, which are still to
  // come, and which are already finished, so a batch survives the page being
  // reloaded and can say "3 of 7" rather than starting over.
  batch      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, userId])
  @@index([updatedAt])
}

// What the assistant has cost this business this month.
//
// Groq bills by tokens, not by request, so a request count would be a
// comfortable number that is not the bill. One row per business per month,
// incremented atomically — nothing here is per-turn history (that is
// AgentTurnLog, which expires); this is the running total a cap is checked
// against and an invoice is explained with.
model AgentUsage {
  id         String   @id @default(cuid())
  businessId String
  /** "2026-10" — the billing month this row totals, in UTC. */
  month      String
  /** Reasoning-model calls, and the tokens they actually consumed. */
  askCalls   Int      @default(0)
  askTokens  Int      @default(0)
  /** Speech-to-text clips, and their total length. Whisper is billed by audio
   * seconds rather than tokens, so it is counted in its own currency. */
  listenCalls   Int   @default(0)
  listenSeconds Int   @default(0)
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, month])
  @@index([month])
}

// One assistant turn, kept briefly so support can see what actually happened.
//
// The audit trail records what was approved and what the screen confirmed,
// which answers "what changed" but not "why did it understand me that way".
// For that you need the owner's own words and the model's raw reply — and
// those are the sensitive parts, so this table only fills while a business has
// Business.diagnosticsUntil set in the future, and every row is swept after a
// short retention window. Nothing here is a system of record; the audit trail
// is.
model AgentTurnLog {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  taskId     String?
  lang       String
  /** What the owner said or typed. Bounded by the request schema. */
  utterance  String
  /** The model's reply exactly as parsed — which capability, which values. */
  modelReply Json?
  workflowId String?
  /** "action" | "clarify" | "reply" | "error", plus the error kind when one. */
  outcome    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([createdAt])
}

// What a mishearing turned out to mean.
//
// Whisper writes "Bundapot" where the owner said "Banda Patil", and a name
// spelled differently matches no record — so a clear instruction ends in
// "I couldn't find that". The vocabulary prompt (vocabulary.ts) reduces this
// but cannot eliminate it, and the owner should not have to re-say a name the
// app has already failed to hear once.
//
// So when they pick the record they meant, the pairing is kept: the next time
// that same mishearing arrives it resolves straight away, and the corrected
// spelling also goes into the prompt so Whisper is less likely to repeat it.
model AgentNameAlias {
  id         String   @id @default(cuid())
  businessId String
  /** The misheard form, normalized (see text.ts) — what to match against. */
  heard      String
  /** "machine" | "operator" | "customer" | "site" — scoped, so a customer
   * called "Patil" cannot start resolving an operator. */
  kind       String
  /** The record's own label, exactly as the app writes it. */
  label      String
  /** How often this pairing has been used, so a stale one can be spotted. */
  hits       Int      @default(1)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, kind, heard])
  @@index([businessId])
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// Support-console sessions: opaque random token (only its sha256 is stored),
// short-lived and individually revocable — replaces the old HMAC token that
// shared AUTH_SECRET with owner sessions and could not be revoked.
model SupportSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([expiresAt])
}

// An operator asking to join a business. Never touches an Operator row until
// an admin approves it, so knowing a business code + a mobile number can no
// longer set or overwrite anyone's PIN. status:
// PENDING | APPROVED | REJECTED | EXPIRED | LOCKED
model OperatorJoinRequest {
  id               String    @id @default(cuid())
  businessId       String
  name             String
  mobile           String
  pinHash          String
  // Short code shown only to the requester; the admin must type it to approve,
  // so a request filed by someone else (who sees the code, not the real
  // operator) is detectable. Stored as an HMAC, never plain.
  verificationHash String
  verifyAttempts   Int       @default(0)
  status           String    @default("PENDING")
  operatorId       String? // existing Operator row this request will be linked to on approval
  expiresAt        DateTime
  decidedAt        DateTime?
  decidedBy        String?
  createdAt        DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([mobile])
  @@index([expiresAt])
}
