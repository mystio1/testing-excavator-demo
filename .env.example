# Copy to .env (never commit .env — it is git-ignored) and fill in real values.
# This file lists variable NAMES with harmless placeholders only.

# --- Database -----------------------------------------------------------------
# Postgres connection string used by the app and `prisma migrate deploy`.
# On Render, use the Internal connection string; on Supabase use the Session
# pooler URL (hard cap: 15 concurrent connections — see DB_POOL_MAX).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# OPTIONAL. Connection used ONLY by the Prisma CLI (`prisma migrate deploy`, the
# Render pre-deploy command) when the schema owner differs from the app's role.
# Lets DATABASE_URL be a least-privilege role (SELECT/INSERT/UPDATE/DELETE, no DDL,
# not the table owner) — see docs/security.md "Database roles". Unset = the CLI
# uses DATABASE_URL.
# MIGRATE_DATABASE_URL="postgresql://OWNER:PASSWORD@HOST:5432/DBNAME"
# Scratch database, only needed for `prisma migrate dev` and the CI drift check.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_shadow"
# Maximum pooled connections (default 10, clamped to 12). Keep below the
# database's own limit minus headroom for migrations/second instance.
# DB_POOL_MAX=10

# --- Auth ---------------------------------------------------------------------
# Signs/encrypts session JWTs. Generate a new one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me"
# Key for operator join-request verification codes (HMAC). Use a DIFFERENT random
# value from AUTH_SECRET so leaking/rotating one does not touch the other. Unset =
# falls back to AUTH_SECRET (the startup log warns in production).
# JOIN_CODE_SECRET="generate-another-32-random-bytes"
# OPTIONAL, TEMPORARY. Roll AUTH_SECRET without signing everyone out: set this to the OLD AUTH_SECRET,
# put the NEW value in AUTH_SECRET, deploy, and remove this after 30 days. See docs/configuration.md section 8.
# AUTH_SECRET_PREVIOUS=""
# Password for the hidden /support console. Leave unset to DISABLE the console
# (its login endpoint then answers 404).
# SUPPORT_ACCESS_PASSWORD=""

# --- Public URL / CSRF / proxies ------------------------------------------------
# Public base URL of THIS deployment. REQUIRED in production: password-reset
# links are built from it (never from request headers) and it is a trusted
# origin for the CSRF check.
APP_URL="https://your-domain.example"
# Extra origins allowed to make state-changing requests (comma separated), e.g.
# the onrender.com URL while you also use a custom domain.
# ALLOWED_ORIGINS="https://your-service.onrender.com"
# Number of reverse proxies in front of the app that append to
# X-Forwarded-For (used for rate-limit client IPs). Render's proxy layer = 1.
# TRUSTED_PROXY_HOPS=1

# --- Email (forgot-password) ----------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Excavator Manager <no-reply@your-domain.example>"

# --- Android in-app updates -----------------------------------------------------
# "owner/repo" whose latest GitHub Release carries version.json (see README).
GITHUB_RELEASE_REPO="owner/repo"
# Optional token to raise GitHub's unauthenticated rate limit.
# GITHUB_API_TOKEN=""

# --- AI assistant (TrackMarg AI Operator) ------------------------------------------
# Groq API key (console.groq.com). Server-side only: it must never reach browser
# code, a generated manifest or a log. Unset = the assistant answers that it is
# not configured; the rest of the app is unaffected.
# Note this is GROQ (groq.com, keys look like gsk_...), not xAI's Grok
# (keys look like xai-...). Groq is used because one key covers both the
# reasoning model and Whisper speech-to-text.
# GROQ_API_KEY=""
#
# Which reasoning model to use. Optional: the default is set in
# src/lib/agent/groq.ts. Override it when an account loses access to a model —
# a name that works today can 404 tomorrow, and the assistant then answers
# "something went wrong" until it is changed (look for groq.request_failed in
# the logs). Whisper's model is not configurable: it is chosen for Marathi and
# Hindi accuracy, not speed.
# GROQ_MODEL=""
#
# Assistant quotas. Every tenant shares one Groq account, so these are what
# keep one busy yard from spending the whole per-minute ceiling and breaking
# the assistant for every other customer. Three rings, narrowest first: user,
# business, then a global backstop. Defaults are conservative and live in
# src/lib/agent/quota.ts — raise them only after confirming what the account's
# tier actually allows, and keep the global one BELOW that.
# AGENT_ASK_PER_USER_MIN=20
# AGENT_ASK_PER_BUSINESS_MIN=30
# AGENT_ASK_PER_BUSINESS_HOUR=400
# AGENT_ASK_GLOBAL_MIN=60
# AGENT_LISTEN_PER_USER_MIN=20
# AGENT_LISTEN_PER_BUSINESS_MIN=30
# AGENT_LISTEN_GLOBAL_MIN=60
#
# A second model to fall back to when the first cannot answer. Unset by
# default, because a fallback nobody has verified against this workload is not
# a fallback. Two failures this guards against both happened in development on
# this account: a model name that had been working stopped existing (404
# model_not_found), and the per-minute allowance ran out.
# GROQ_MODEL_FALLBACK=""
#
# Models a single business may be moved to (comma separated), on top of
# GROQ_MODEL and the fallback. The per-business override (Business.
# assistantModel) is checked against this list rather than taken as free text:
# an arbitrary value in a database row would be a way to point that business's
# spending at an unknown model, and the shared account pays for it.
# GROQ_MODELS_ALLOWED=""
#
# Breaker: after this many consecutive service failures the assistant answers
# immediately for a cooldown instead of making the owner wait out the timeout
# on every attempt.
# AGENT_BREAKER_FAILURES=4
# AGENT_BREAKER_COOLDOWN_MS=30000
#
# Monthly ceilings per business — the backstop rate limits cannot provide,
# since a yard can stay inside every per-minute ring and still run a bill
# nobody budgeted for. Counted in what each service actually bills in: tokens
# for the model, audio seconds for speech. 0 disables a cap.
# AGENT_ASK_TOKENS_PER_MONTH=2000000
# AGENT_LISTEN_SECONDS_PER_MONTH=36000
#
# Which assistant languages the picker offers. Nine exist in the strings; only
# English, Hindi and Marathi have been read by a speaker, so those are offered
# by default (see REVIEWED in src/lib/agent/i18n.ts). Set this to turn the
# others on for a willing customer, or once somebody has checked them:
#   gu Gujarati - ta Tamil - te Telugu - kn Kannada - bn Bengali - pa Punjabi
# NEXT_PUBLIC_AGENT_LANGS_ENABLED="en,hi,mr"
#
# How long assistant diagnostics are kept once support opens a window on a
# business (see docs/assistant.md). What is recorded is the owner's own words,
# so this is short by default and the rows are deleted when the window closes.
# AGENT_DIAGNOSTICS_RETENTION_DAYS=7

# --- Observability --------------------------------------------------------------
# debug | info | warn | error (default info). Logs are one JSON object per line.
# LOG_LEVEL=info

# --- Tests ----------------------------------------------------------------------
# DB-backed tests create/delete throwaway businesses. Point this at a NON-production
# database (falls back to DATABASE_URL when unset).
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME_test"

# --- Tooling only (never needed by the running app) -------------------------------
# Database the restore drill (scripts/restore-drill.mjs) reads from; use a NON-production one.
# DRILL_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# Override the migrations directory (used by scripts/test-migrations.mjs); leave unset normally.
# PRISMA_MIGRATIONS_PATH="prisma/migrations"

# --- Speech for Hindi and Marathi (optional) --------------------------------
# AI4Bharat's IndicConformer, run as a sidecar (see services/indic-asr/README.md).
# Measured on Marathi against reference transcripts: WER 0.067 against Whisper's
# 0.653 — roughly ten times fewer errors, and faster.
#
# Unset means every language uses Whisper, which is what happened before this
# existed. When the sidecar is set but unreachable, the app falls back to
# Whisper rather than failing the turn.
INDIC_ASR_URL=
# Languages to send there. Defaults to the two that were measured.
INDIC_ASR_LANGS=hi,mr
# Your Hugging Face token. The model is gated: accept the terms once at
# https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual
# Only the SIDECAR needs this, never the web app.
HF_TOKEN=
# Shared secret, REQUIRED once the sidecar is reachable from anywhere but
# localhost — otherwise it is an open speech-to-text service for whoever finds
# the address. Generate with: openssl rand -hex 32
INDIC_ASR_TOKEN=
