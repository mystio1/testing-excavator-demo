# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite database files (self-hosted local data, never committed)
/*.db
/*.db-journal
prisma/*.db
prisma/*.db-journal

# local AI tooling state — not part of the application
/.agents/
/.claude/
/.windsurf/
/skills-lock.json

# unrelated design-reference scrapes, not app content
/design/

# Playwright (browser tests for the assistant)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
