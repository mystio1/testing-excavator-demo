<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the app launch Android's own package-installer UI for a
         downloaded APK. This is an install-time permission (no runtime
         prompt) — it does not by itself allow installing anything; the user
         still has to grant "install unknown apps" for this app specifically
         via system Settings the first time, and then confirm each install
         in Android's own installer screen. See UpdateInstallerPlugin. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The assistant's voice input. getUserMedia() inside the WebView cannot
         work without this, whatever the page does: Android checks the app's own
         permission before the WebView is allowed the microphone at all, so the
         browser-level "please allow the microphone" prompt never even appears.
         RECORD_AUDIO is a runtime permission on Android 6+, so holding it here
         is necessary but not sufficient — MainActivity asks for it the first
         time the assistant needs it. MODIFY_AUDIO_SETTINGS lets the recorder
         apply the noise suppression and automatic gain the yard needs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
